/uboot               emmc     /dev/block/by-name/uboot                               flags=display=uboot;slotselect
/sml                 emmc     /dev/block/by-name/sml                                 flags=display=sml;slotselect
/tos                 emmc     /dev/block/by-name/trustos                             flags=display=tos;slotselect
/teecfg              emmc     /dev/block/by-name/teecfg                              flags=display=teecfg;slotselect
/vbmeta              emmc     /dev/block/by-name/vbmeta                              flags=display=vbmeta;slotselect;backup=1
/vbmeta_odm          emmc     /dev/block/by-name/vbmeta_odm                          flags=display=vbmeta_odm;slotselect;backup=1
/vbmeta_product      emmc     /dev/block/by-name/vbmeta_product                      flags=display=vbmeta_product;slotselect;backup=1
/vbmeta_system       emmc     /dev/block/by-name/vbmeta_system                       flags=display=vbmeta_system;slotselect;backup=1
/vbmeta_system_ext   emmc     /dev/block/by-name/vbmeta_system_ext                   flags=display=vbmeta_system_ext;slotselect;backup=1
/vbmeta_vendor       emmc     /dev/block/by-name/vbmeta_vendor                       flags=display=vbmeta_vendor;slotselect;backup=1
/dtbo                emmc     /dev/block/by-name/dtbo                                flags=display=dtbo;slotselect;backup=1
/ltedsp              emmc     /dev/block/by-name/l_ldsp                              flags=display=ltedsp;slotselect;backup=1
/ltegdsp             emmc     /dev/block/by-name/l_gdsp                              flags=display=ltegdsp;slotselect;backup=1
/lteagdsp            emmc     /dev/block/by-name/l_agdsp                             flags=display=lteagdsp;slotselect;backup=1
/ltemodem            emmc     /dev/block/by-name/l_modem                             flags=display=ltemodem;slotselect;backup=1
/ltefixnv1           emmc     /dev/block/by-name/l_fixnv1                            flags=display=ltefixnv1;slotselect;backup=1
/ltefixnv2           emmc     /dev/block/by-name/l_fixnv2                            flags=display=ltefixnv2;slotselect;backup=1
/ltedeltanv          emmc     /dev/block/by-name/l_deltanv                           flags=display=ltedeltanv;slotselect;backup=1
/lteruntimenv1       emmc     /dev/block/by-name/l_runtimenv1                        flags=display=lteruntimenv1;slotselect;backup=1
/lteruntimenv2       emmc     /dev/block/by-name/l_runtimenv2                        flags=display=lteruntimenv2;slotselect;backup=1
/wcnmodem            emmc     /dev/block/by-name/wcnmodem                            flags=display=wcnmodem;slotselect;backup=1
/gnssmodem           emmc     /dev/block/by-name/gnssmodem                           flags=display=gnssmodem;slotselect;backup=1
/pmsys               emmc     /dev/block/by-name/pm_sys                              flags=display=pmsys;slotselect
/misc                emmc     /dev/block/by-name/misc                                flags=display=misc
/boot                emmc     /dev/block/by-name/boot                                flags=display=boot;slotselect;backup=1;flashimg=1
/persist             emmc     /dev/block/by-name/persist                             flags=display=persist
/logo                emmc     /dev/block/by-name/logo                                flags=display=logo
/fbootlogo           emmc     /dev/block/by-name/fbootlogo                           flags=display=fbootlogo
/system_root         ext4     /dev/block/mapper/system                               flags=display="System";slotselect;backup=1;flashimg=1;wipeingui
/system_ext          ext4     /dev/block/mapper/system_ext                           flags=display="System-ext";slotselect;backup=1;flashimg=1;wipeingui
/product             ext4     /dev/block/mapper/product                              flags=display="Product";slotselect;backup=1;flashimg=1;wipeingui
/vendor              ext4     /dev/block/mapper/vendor                               flags=display="Vendor";slotselect;backup=1;flashimg=1;wipeingui
/metadata            ext4     /dev/block/by-name/metadata                            flags=display=metadata
/socko               ext4     /dev/block/by-name/socko                               flags=display=socko;slotselect
/odmko               ext4     /dev/block/by-name/odmko                               flags=display=odmko;slotselect
/mnt/vendor          ext4     /dev/block/by-name/prodnv                              flags=display=prodnv
/data                f2fs     /dev/block/by-name/userdata                            flags=display="Data";backup=1;fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized

#removable storage
/external_sd         vfat     /dev/block/mmcblk1p1       /dev/block/mmcblk1          flags=display="external_sd";storage;removable
